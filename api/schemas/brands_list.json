{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandsListResponse",
  "description": "Schema for GET /brandsList response payload.",
  "type": "object",
  "required": ["brands"],
  "properties": {
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "brand"],
        "properties": {
          "id": { "type": "integer" },
          "brand": { "type": "string" }
        }
      }
    }
  }
}

