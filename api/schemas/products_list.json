{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductsListResponse",
  "description": "Schema for GET /productsList response payload.",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" }
        }
      }
    }
  }
}

